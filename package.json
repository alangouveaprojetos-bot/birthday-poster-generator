{
  "name": "birthday-poster-generator",
  "version": "1.0.0",
  "description": "Sistema completo de geração de cartazes de aniversário com customização, PDF em alta resolução, compartilhamento social e painel administrativo",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "jest",
    "lint": "eslint .",
    "migrate": "node server/migrations/run.js"
  },
  "keywords": [
    "birthday",
    "poster",
    "generator",
    "pdf",
    "social-sharing"
  ],
  "author": "Alan Gouve Projetos",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^8.0.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.13.0",
    "sharp": "^0.33.0",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0",
    "concurrently": "^8.2.2"
  }
}
